# Skopiuj do .env i dostosuj. Wszystko OPCJONALNE — usługa działa bez tego pliku.

# Własny User-Agent wysyłany do źródła (CheapShark wymaga opisowego UA).
SCRAPER_USER_AGENT=rapidapi-listings/1.0 (+https://rapidapi.com; you@example.com)

# Proxy OPCJONALNE. Podaj pełny URL, jeśli chcesz kierować ruch przez proxy.
# Puste = brak proxy (domyślnie). Obsługiwane też standardowe HTTP_PROXY/HTTPS_PROXY.
# SCRAPER_PROXY_URL=http://user:pass@host:port

# Domyślny plan, gdy brak nagłówka RapidAPI (do lokalnych testów).
DEFAULT_PLAN=FREE
